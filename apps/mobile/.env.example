# Copy to .env.local. Local values are printed by `pnpm db:start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional social sign-in (FR-1.1); also enable the providers in supabase/config.toml.
# EXPO_PUBLIC_APPLE_SIGN_IN=1
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time (app.config.ts): EAS_PROJECT_ID, GOOGLE_IOS_URL_SCHEME, GOOGLE_MAPS_ANDROID_API_KEY
